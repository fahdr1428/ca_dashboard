# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/ca_dashboard?schema=public"

# Shared passphrase for signing in. Use something long.
DASHBOARD_PASSWORD="change-me"

# Random string, 24+ characters, used to sign session cookies.
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Bearer token the scheduler presents to /api/cron/weekly.
# Generate with: openssl rand -hex 32
CRON_SECRET="change-me"

# ---------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------

# Companies House REST API key — free, from
# https://developer.company-information.service.gov.uk/
# Without this the Companies House connector is skipped and the dashboard runs
# on demo data only. This is the connector that makes ownership verifiable.
COMPANIES_HOUSE_API_KEY=""

# Business-news RSS feeds, comma separated. Leave unset to use the built-in
# South West / South East regional business feeds.
# NEWS_FEEDS="https://example.com/feed,https://example.org/rss"

# Set to "false" to disable the news connector entirely.
# ENABLE_NEWS_CONNECTOR="true"

# ---------------------------------------------------------------------------
# Weekly report delivery (optional)
# ---------------------------------------------------------------------------

# Any webhook that accepts JSON — Slack, Teams, Zapier, Make.
# REPORT_WEBHOOK_URL=""

# Email delivery via Resend (https://resend.com). Both are required for email.
# RESEND_API_KEY=""
# REPORT_EMAIL_TO="advisor@example.com"
# REPORT_EMAIL_FROM="Lead Intelligence <reports@yourdomain.com>"
